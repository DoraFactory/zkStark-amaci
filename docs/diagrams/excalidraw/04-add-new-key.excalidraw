    {
      "type": "text",
      "id": "t_witness_body",
      "x": 78.31322391678697,
      "y": 124.20157954099886,
      "width": 189.65625,
      "height": 277.44978331483674,
      "text": "- oldPrivateKey\n- coordPubKey\n- c1, c2\n  (STARK curve ElGamal\n   ciphertext in deact leaf)\n- randomVal\n  (for rerandomization)\n- d1, d2\n  (rerandomized ciphertext)\n- sharedKey\n  (STARK curve ECDH:\n   oldPrivKey × coordPubKey)\n- deactivateIndex\n- deactivateLeafPath[0..3]\n- newPubKey\n- pollId",
