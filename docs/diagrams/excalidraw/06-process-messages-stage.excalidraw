    {
      "type": "text",
      "id": "t_crosslinks",
      "x": 60,
      "y": 588,
      "width": 760,
      "height": 36,
      "text": "State root chain (reverse order):  Core[2].current == Boundary.current  |  Core[2].new == Core[1].current  |  Core[0].new == Boundary.new\nData consistency:  CoordKey.privKeyHash == all Core[i].privKeyHash   |   ECDH[i].sharedKeyHash == Core[i].sharedKeyHash",
      "originalText": "State root chain (reverse order):  Core[2].current == Boundary.current  |  Core[2].new == Core[1].current  |  Core[0].new == Boundary.new\nData consistency:  CoordKey.privKeyHash == all Core[i].privKeyHash   |   ECDH[i].sharedKeyHash == Core[i].sharedKeyHash",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#666666",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
