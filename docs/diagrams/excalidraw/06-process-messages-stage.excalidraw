    {
      "type": "text",
      "id": "t_boundary_body",
      "x": 80,
      "y": 524,
      "width": 720,
      "height": 36,
      "text": "currentStateCommitment = H(currentStateRoot, salt)   |   newStateCommitment = H(newStateRoot, salt)\ndeactivateCommitment = H(activeStateRoot, deactivateRoot)   |   message hash chain   |   inputHash",
      "originalText": "currentStateCommitment = H(currentStateRoot, salt)   |   newStateCommitment = H(newStateRoot, salt)\ndeactivateCommitment = H(activeStateRoot, deactivateRoot)   |   message hash chain   |   inputHash",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
