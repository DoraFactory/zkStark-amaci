    {
      "type": "text",
      "id": "t_s5_body",
      "x": 80,
      "y": 622,
      "width": 660,
      "height": 74,
      "text": "Atlantic wraps Cairo program output in a metadata wrapper program\nmetadata_output contains:  Atlantic metadata  |  child_program_hash  |  Cairo program public output\n\nfact_hash = H(metadata_program_hash, H(metadata_output))\nWritten to Integrity FactRegistry  →  AMACI contract queries this to confirm proof validity",
      "originalText": "Atlantic wraps Cairo program output in a metadata wrapper program\nmetadata_output contains:  Atlantic metadata  |  child_program_hash  |  Cairo program public output\n\nfact_hash = H(metadata_program_hash, H(metadata_output))\nWritten to Integrity FactRegistry  →  AMACI contract queries this to confirm proof validity",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
