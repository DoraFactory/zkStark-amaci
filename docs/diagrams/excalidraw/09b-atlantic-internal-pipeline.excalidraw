    {
      "type": "text",
      "id": "t_s4_body",
      "x": 80,
      "y": 500,
      "width": 660,
      "height": 54,
      "text": "STARK proof → felt252[] has thousands of elements, exceeds single tx calldata limit\ntx 1~(n-1):  write proof data to on-chain temp storage  (verify_proof_initial / verify_proof_step)\ntx n:  trigger final verification  (verify_proof_final_and_register_fact)",
      "originalText": "STARK proof → felt252[] has thousands of elements, exceeds single tx calldata limit\ntx 1~(n-1):  write proof data to on-chain temp storage  (verify_proof_initial / verify_proof_step)\ntx n:  trigger final verification  (verify_proof_final_and_register_fact)",
      "fontSize": 12,
      "fontFamily": 3,
